# Copy to tenants/<label>.env (gitignored). All values below are placeholders.
TENANT_LABEL=contoso
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
GIT_REPO=git@github.com:contoso/entra-config-snapshots.git

# Optional: ntfy notifications (high = drift, urgent = failure). Unset = silent.
